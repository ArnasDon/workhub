# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Postgres connection string for Drizzle (Project Settings → Database → Connection string → URI).
# Use the "Transaction" pooler (port 6543) on Vercel/serverless; the direct connection (5432) works locally.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# The only email address allowed to sign in. Anyone else is signed out immediately.
ALLOWED_EMAIL=you@example.com
