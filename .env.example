# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Postgres connection string for Drizzle (Project Settings → Database → Connection string → URI).
# Use the "Transaction" pooler (port 6543) on Vercel/serverless; the direct connection (5432) works locally.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Optional allowlist. One address or a comma-separated list; only these can register or sign in.
# Leave it unset (or empty) to let anyone register: multi-user mode.
# ALLOWED_EMAIL=you@example.com

# Optional. Lets "Delete my account" remove the Supabase Auth user as well as the data.
# Project Settings → API → service_role key. Server-only; never expose it to the browser.
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
